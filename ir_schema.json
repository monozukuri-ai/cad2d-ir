{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/cad-ir.schema.json",
  "title": "CAD-IR (Intermediate Representation for CAD Drawings)",
  "type": "object",
  "required": ["format", "version", "header", "entities"],
  "additionalProperties": false,

  "properties": {
    "format": { "const": "cad2d-ir" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },

    "source": { "$ref": "#/$defs/SourceInfo" },

    "header": {
      "type": "object",
      "additionalProperties": false,
      "required": ["units", "angle_unit", "coord_space"],
      "properties": {
        "units": {
          "description": "Drawing units. If 'custom', interpret 'unit_scale_to_mm'.",
          "type": "string",
          "enum": ["mm", "cm", "m", "inch", "ft", "unitless", "unknown", "custom"]
        },
        "unit_scale_to_mm": {
          "description": "Only used when units=custom. drawing_unit * unit_scale_to_mm = millimeter.",
          "type": "number",
          "exclusiveMinimum": 0
        },
        "angle_unit": { "type": "string", "enum": ["deg", "rad"] },

        "coord_space": {
          "description": "Coordinate space for entity geometry. 'world' is CAD-like. 'normalized' is [0,1] relative to source image.",
          "type": "string",
          "enum": ["world", "normalized"]
        },

        "bbox": {
          "description": "Optional drawing bounds in the same coord_space.",
          "$ref": "#/$defs/BBox2"
        },

        "precision": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "coord_decimals": { "type": "integer", "minimum": 0, "maximum": 8 },
            "angle_decimals": { "type": "integer", "minimum": 0, "maximum": 8 },
            "snap_tolerance": {
              "description": "Suggested tolerance in drawing units for snapping/merging in post-processing.",
              "type": "number",
              "minimum": 0
            }
          }
        },

        "source_image": {
          "description": "Optional info about the raster source and mapping to drawing space.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "image_id": { "type": "string" },
            "width_px": { "type": "integer", "minimum": 1 },
            "height_px": { "type": "integer", "minimum": 1 },

            "pixel_to_drawing_affine": {
              "description": "2D affine: [a,b,c,d,e,f] meaning x=a*xp+b*yp+c, y=d*xp+e*yp+f. Useful when coord_space=world and you estimated calibration.",
              "$ref": "#/$defs/Affine2D"
            },

            "dpi": { "type": "number", "exclusiveMinimum": 0 }
          }
        },

        "metadata": { "type": "object" }
      },
      "allOf": [
        {
          "if": { "properties": { "units": { "const": "custom" } } },
          "then": { "required": ["unit_scale_to_mm"] }
        }
      ]
    },

    "tables": {
      "description": "Optional dictionaries/tables similar to DXF tables.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "layers": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/LayerDef" },
          "default": {}
        },
        "linetypes": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/LinetypeDef" },
          "default": {}
        },
        "text_styles": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/TextStyleDef" },
          "default": {}
        },
        "dim_styles": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/DimStyleDef" },
          "default": {}
        },
        "blocks": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/BlockDef" },
          "default": {}
        }
      }
    },

    "entities": {
      "description": "Modelspace entities. Entity id values must be unique in this array.",
      "type": "array",
      "minItems": 0,
      "items": { "$ref": "#/$defs/Entity" }
    },

    "constraints": {
      "description": "Optional geometric constraints for post-processing (snapping/orthogonality/parallelism etc.).",
      "type": "array",
      "items": { "$ref": "#/$defs/Constraint" }
    }
  },

  "$defs": {
    "Point2": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [{ "type": "number" }, { "type": "number" }],
      "items": false
    },

    "BBox2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "max"],
      "properties": {
        "min": { "$ref": "#/$defs/Point2" },
        "max": { "$ref": "#/$defs/Point2" }
      }
    },

    "Affine2D": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "prefixItems": [
        { "type": "number" },
        { "type": "number" },
        { "type": "number" },
        { "type": "number" },
        { "type": "number" },
        { "type": "number" }
      ],
      "items": false
    },

    "NonZeroNumber": {
      "type": "number",
      "not": { "const": 0 }
    },

    "SourceInfo": {
      "description": "Drawing-level provenance for the imported source.",
      "type": "object",
      "additionalProperties": false,
      "required": ["format"],
      "properties": {
        "format": { "type": "string", "enum": ["dxf", "dwg", "dgn", "dwf", "jww", "mi", "sxf", "unknown"] },
        "version": { "type": "string" },
        "name": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
        "metadata": { "type": "object" }
      }
    },

    "EntitySource": {
      "description": "Reference back to the source record that produced an IR entity.",
      "type": "object",
      "additionalProperties": false,
      "required": ["format"],
      "properties": {
        "format": { "type": "string", "enum": ["dxf", "dwg", "dgn", "dwf", "jww", "mi", "sxf", "unknown"] },
        "id": { "type": "string" },
        "kind": { "type": "string" },
        "metadata": { "type": "object" }
      }
    },

    "Approximation": {
      "description": "Records an intentional geometry approximation performed by an importer.",
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "source_kind"],
      "properties": {
        "method": { "type": "string", "enum": ["polyline", "spline", "other"] },
        "source_kind": { "type": "string" },
        "segments": { "type": "integer", "minimum": 1 },
        "tolerance": { "type": "number", "minimum": 0 },
        "metadata": { "type": "object" }
      }
    },

    "Color": {
      "description": "Either ACI index (0..256) or RGBA hex (#RRGGBB or #RRGGBBAA).",
      "oneOf": [
        { "type": "integer", "minimum": 0, "maximum": 256 },
        { "type": "string", "pattern": "^#([A-Fa-f0-9]{6}|[A-Fa-f0-9]{8})$" }
      ]
    },

    "EntityCommon": {
      "type": "object",
      "required": ["id", "kind"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_\\-:.]{0,63}$" },
        "kind": { "type": "string" },

        "layer": { "type": "string", "default": "0" },
        "linetype": { "type": "string" },
        "color": { "$ref": "#/$defs/Color" },
        "lineweight_mm": { "type": "number", "minimum": 0 },

        "visible": { "type": "boolean", "default": true },
        "source": { "$ref": "#/$defs/EntitySource" },
        "approximation": { "$ref": "#/$defs/Approximation" },
        "metadata": { "type": "object" }
      }
    },

    "LayerDef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "color": { "$ref": "#/$defs/Color" },
        "linetype": { "type": "string" },
        "lineweight_mm": { "type": "number", "minimum": 0 },
        "plot": { "type": "boolean", "default": true },
        "metadata": { "type": "object" }
      }
    },

    "LinetypeDef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "description": { "type": "string" },
        "pattern_mm": {
          "description": "Dash-gap pattern lengths in mm: [dash, gap, dash, gap, ...].",
          "type": "array",
          "items": { "type": "number" }
        }
      }
    },

    "TextStyleDef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "font": { "type": "string" },
        "height": { "type": "number", "minimum": 0 },
        "width_factor": { "type": "number", "exclusiveMinimum": 0 },
        "oblique_deg": { "type": "number" }
      }
    },

    "DimStyleDef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "arrow_size": { "type": "number", "minimum": 0 },
        "text_height": { "type": "number", "minimum": 0 },
        "extension_offset": { "type": "number", "minimum": 0 },
        "extension_overhang": { "type": "number", "minimum": 0 },
        "baseline_spacing": { "type": "number", "minimum": 0 }
      }
    },

    "BlockDef": {
      "description": "Block definition. Entities inside block use the same schema as top-level entities (2D).",
      "type": "object",
      "additionalProperties": false,
      "required": ["base_point", "entities"],
      "properties": {
        "base_point": { "$ref": "#/$defs/Point2" },
        "entities": {
          "description": "Block-local entities. Entity id values must be unique within this block.",
          "type": "array",
          "items": { "$ref": "#/$defs/Entity" }
        },
        "metadata": { "type": "object" }
      }
    },

    "Vertex2": {
      "description": "Polyline vertex as [x,y] or [x,y,bulge]. bulge = tan(theta/4) (DXF compatible).",
      "oneOf": [
        {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [{ "type": "number" }, { "type": "number" }],
          "items": false
        },
        {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "prefixItems": [{ "type": "number" }, { "type": "number" }, { "type": "number" }],
          "items": false
        }
      ]
    },

    "EntityLine": {
      "unevaluatedProperties": false,
      "allOf": [
        { "$ref": "#/$defs/EntityCommon" },
        {
          "type": "object",
          "required": ["kind", "p1", "p2"],
          "properties": {
            "kind": { "const": "LINE" },
            "p1": { "$ref": "#/$defs/Point2" },
            "p2": { "$ref": "#/$defs/Point2" }
          }
        }
      ]
    },

    "EntityCircle": {
      "unevaluatedProperties": false,
      "allOf": [
        { "$ref": "#/$defs/EntityCommon" },
        {
          "type": "object",
          "required": ["kind", "center", "radius"],
          "properties": {
            "kind": { "const": "CIRCLE" },
            "center": { "$ref": "#/$defs/Point2" },
            "radius": { "type": "number", "exclusiveMinimum": 0 }
          }
        }
      ]
    },

    "EntityArc": {
      "unevaluatedProperties": false,
      "allOf": [
        { "$ref": "#/$defs/EntityCommon" },
        {
          "type": "object",
          "required": ["kind", "center", "radius", "start_angle", "end_angle"],
          "properties": {
            "kind": { "const": "ARC" },
            "center": { "$ref": "#/$defs/Point2" },
            "radius": { "type": "number", "exclusiveMinimum": 0 },
            "start_angle": { "type": "number" },
            "end_angle": { "type": "number" },
            "ccw": {
              "description": "If omitted, interpret by standard CAD convention (increasing angle is CCW in XY).",
              "type": "boolean"
            }
          }
        }
      ]
    },

    "EntityPoint": {
      "unevaluatedProperties": false,
      "allOf": [
        { "$ref": "#/$defs/EntityCommon" },
        {
          "type": "object",
          "required": ["kind", "position"],
          "properties": {
            "kind": { "const": "POINT" },
            "position": { "$ref": "#/$defs/Point2" },
            "marker_code": { "type": "integer" },
            "rotation": { "type": "number", "default": 0 },
            "scale": { "type": "number", "exclusiveMinimum": 0 },
            "temporary": { "type": "boolean", "default": false }
          }
        }
      ]
    },

    "EntityEllipse": {
      "unevaluatedProperties": false,
      "allOf": [
        { "$ref": "#/$defs/EntityCommon" },
        {
          "type": "object",
          "required": ["kind", "center", "major_axis", "ratio", "start_param", "end_param"],
          "properties": {
            "kind": { "const": "ELLIPSE" },
            "center": { "$ref": "#/$defs/Point2" },
            "major_axis": {
              "description": "Vector from center to the major-axis endpoint.",
              "$ref": "#/$defs/Point2"
            },
            "ratio": {
              "description": "Minor-axis radius divided by major-axis radius.",
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1
            },
            "start_param": { "description": "Ellipse start parameter in radians.", "type": "number" },
            "end_param": { "description": "Ellipse end parameter in radians.", "type": "number" },
            "ccw": { "type": "boolean", "default": true }
          }
        }
      ]
    },

    "EntityLWPolyline": {
      "unevaluatedProperties": false,
      "allOf": [
        { "$ref": "#/$defs/EntityCommon" },
        {
          "type": "object",
          "required": ["kind", "vertices"],
          "properties": {
            "kind": { "const": "LWPOLYLINE" },
            "vertices": {
              "type": "array",
              "minItems": 2,
              "items": { "$ref": "#/$defs/Vertex2" }
            },
            "closed": { "type": "boolean", "default": false }
          }
        }
      ]
    },

    "EntitySpline": {
      "unevaluatedProperties": false,
      "allOf": [
        { "$ref": "#/$defs/EntityCommon" },
        {
          "type": "object",
          "required": ["kind", "degree", "control_points"],
          "properties": {
            "kind": { "const": "SPLINE" },
            "degree": { "type": "integer", "minimum": 1, "maximum": 7 },
            "control_points": {
              "type": "array",
              "minItems": 2,
              "items": { "$ref": "#/$defs/Point2" }
            },
            "knots": {
              "type": "array",
              "items": { "type": "number" }
            },
            "weights": {
              "type": "array",
              "items": { "type": "number", "exclusiveMinimum": 0 }
            },
            "closed": { "type": "boolean", "default": false }
          }
        }
      ]
    },

    "TextAlignH": { "type": "string", "enum": ["left", "center", "right"] },
    "TextAlignV": { "type": "string", "enum": ["baseline", "bottom", "middle", "top"] },

    "EntityText": {
      "unevaluatedProperties": false,
      "allOf": [
        { "$ref": "#/$defs/EntityCommon" },
        {
          "type": "object",
          "required": ["kind", "insert", "height", "text"],
          "properties": {
            "kind": { "const": "TEXT" },
            "insert": { "$ref": "#/$defs/Point2" },
            "height": { "type": "number", "exclusiveMinimum": 0 },
            "rotation": { "type": "number", "default": 0 },
            "text": { "type": "string" },
            "style": { "type": "string" },
            "halign": { "$ref": "#/$defs/TextAlignH", "default": "left" },
            "valign": { "$ref": "#/$defs/TextAlignV", "default": "baseline" },
            "width_factor": { "type": "number", "exclusiveMinimum": 0 },
            "oblique_deg": { "type": "number" }
          }
        }
      ]
    },

    "MTextAttach": {
      "type": "string",
      "enum": [
        "top_left", "top_center", "top_right",
        "middle_left", "middle_center", "middle_right",
        "bottom_left", "bottom_center", "bottom_right"
      ]
    },

    "EntityMText": {
      "unevaluatedProperties": false,
      "allOf": [
        { "$ref": "#/$defs/EntityCommon" },
        {
          "type": "object",
          "required": ["kind", "insert", "height", "text"],
          "properties": {
            "kind": { "const": "MTEXT" },
            "insert": { "$ref": "#/$defs/Point2" },
            "height": { "type": "number", "exclusiveMinimum": 0 },
            "rotation": { "type": "number", "default": 0 },
            "width": { "type": "number", "minimum": 0 },
            "text": { "type": "string" },
            "style": { "type": "string" },
            "attach": { "$ref": "#/$defs/MTextAttach", "default": "top_left" }
          }
        }
      ]
    },

    "EntityInsert": {
      "unevaluatedProperties": false,
      "allOf": [
        { "$ref": "#/$defs/EntityCommon" },
        {
          "type": "object",
          "required": ["kind", "block", "insert"],
          "properties": {
            "kind": { "const": "INSERT" },
            "block": { "type": "string" },
            "insert": { "$ref": "#/$defs/Point2" },
            "rotation": { "type": "number", "default": 0 },
            "scale": {
              "description": "Non-zero uniform scale or [sx,sy]. Negative values represent mirroring.",
              "oneOf": [
                { "$ref": "#/$defs/NonZeroNumber" },
                {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "prefixItems": [
                    { "$ref": "#/$defs/NonZeroNumber" },
                    { "$ref": "#/$defs/NonZeroNumber" }
                  ],
                  "items": false
                }
              ],
              "default": 1
            },
            "transform": {
              "description": "Optional complete affine transform when insert/rotation/scale cannot express the source transform exactly.",
              "$ref": "#/$defs/Affine2D"
            },
            "attributes": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            }
          }
        }
      ]
    },

    "EntityHatch": {
      "description": "Simplified hatch: each loop is a closed polyline. Convert to DXF HATCH later.",
      "unevaluatedProperties": false,
      "allOf": [
        { "$ref": "#/$defs/EntityCommon" },
        {
          "type": "object",
          "required": ["kind", "loops"],
          "properties": {
            "kind": { "const": "HATCH" },
            "solid": { "type": "boolean", "default": true },
            "pattern": { "type": "string" },
            "loops": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["vertices"],
                "properties": {
                  "vertices": {
                    "type": "array",
                    "minItems": 3,
                    "items": { "$ref": "#/$defs/Vertex2" }
                  },
                  "is_outer": { "type": "boolean", "default": true }
                }
              }
            }
          }
        }
      ]
    },

    "EntityDimension": {
      "description": "Semantic dimension (optional). Converting to DXF DIMENSION may require style and placement logic.",
      "unevaluatedProperties": false,
      "allOf": [
        { "$ref": "#/$defs/EntityCommon" },
        {
          "type": "object",
          "required": ["kind", "dim_kind", "definition"],
          "properties": {
            "kind": { "const": "DIMENSION" },
            "dim_kind": {
              "type": "string",
              "enum": ["GENERIC", "LINEAR", "ALIGNED", "ANGULAR", "RADIAL", "DIAMETER", "ORDINATE"]
            },
            "style": { "type": "string" },
            "definition": {
              "type": "object",
              "description": "Flexible container. Recommended keys: refs, points, text, location.",
              "additionalProperties": true
            }
          }
        }
      ]
    },

    "Entity": {
      "oneOf": [
        { "$ref": "#/$defs/EntityLine" },
        { "$ref": "#/$defs/EntityCircle" },
        { "$ref": "#/$defs/EntityArc" },
        { "$ref": "#/$defs/EntityPoint" },
        { "$ref": "#/$defs/EntityEllipse" },
        { "$ref": "#/$defs/EntityLWPolyline" },
        { "$ref": "#/$defs/EntitySpline" },
        { "$ref": "#/$defs/EntityText" },
        { "$ref": "#/$defs/EntityMText" },
        { "$ref": "#/$defs/EntityInsert" },
        { "$ref": "#/$defs/EntityHatch" },
        { "$ref": "#/$defs/EntityDimension" }
      ]
    },

    "FeatureRef": {
      "description": "Reference to a feature on an entity (for constraints). 'feature' is a symbolic path like 'p1', 'p2', 'center', 'v[3]'.",
      "type": "object",
      "additionalProperties": false,
      "required": ["entity", "feature"],
      "properties": {
        "entity": { "type": "string" },
        "feature": { "type": "string" }
      }
    },

    "Constraint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "refs"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "COINCIDENT",
            "HORIZONTAL",
            "VERTICAL",
            "PARALLEL",
            "PERPENDICULAR",
            "CONCENTRIC",
            "EQUAL_LENGTH",
            "EQUAL_RADIUS",
            "COLLINEAR"
          ]
        },
        "refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/FeatureRef" }
        },
        "tolerance": {
          "description": "Optional tolerance in drawing units.",
          "type": "number",
          "minimum": 0
        },
        "metadata": { "type": "object" }
      }
    }
  }
}
